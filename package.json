    "@typescript-eslint/parser": "^8.56.1",
    "astro": "^5.17.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-plugin-astro": "^1.6.0",
    "hono": "^4.12.4",
    "lucide-react": "^0.576.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "wrangler": "^4.70.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "daisyui": "^5.5.19",
    "prettier-plugin-tailwindcss": "^0.7.2"
